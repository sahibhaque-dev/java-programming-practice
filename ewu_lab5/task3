
package lab5;


class person{
    String name ;
 int age ;
    
    public person(String name , int b){
        this.name=name;
        this.age=b;
    }
    
     void display() {
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
    }
    
    
}

class Employee extends person{
    int salary ;
    
    Employee(String a , int b,int c){
        super(a,b);
        this.salary=c;
    }
    @Override
    void display() {
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("salary: " + salary);
    }
    
}

