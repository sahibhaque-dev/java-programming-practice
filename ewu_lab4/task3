package lab4;

import java.util.Scanner;

class rectangle {

    private double height, width;

    double get_height() {
        return height;
    }

    double get_width() {
        return width;
    }

    void set_value(double a, double b) {
        height = a;
        width = b;
    }
}

class area {

    double calc_area(rectangle r) {
        return r.get_height() * r.get_width();
    }
}

public class task3 {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
 
        System.out.print("enter height: ");
        double h = sc.nextDouble();
        System.out.print("enter  width: ");
        double w = sc.nextDouble();

        rectangle r1 = new rectangle();
        r1.set_value(h, w);

        area a = new area();
       

        System.out.println("The area of the rectangle: " + a.calc_area(r1));

        sc.close();
    }
}
