        low(score);  

    }

    public static void  max(int[] score){
        int max = score[0];
        int p = 0;
        int n = score.length;
        for (int i = 1; i < n; i++) {
            if (score[i] > max) {
                max = score[i];
                p = i;
                
                
   
            }
        }
        System.out.println("Highest Value: " + max + " at Index:" + p);
    }
    
    public static void  low(int[] score){
        int low = score[0];
        int p2 = 0;
         int n = score.length;
        for (int i = 1; i < n; i++) {
            if (score[i] < low) {
                low = score[i];
                p2 = i;
            }   
 
        }
        System.out.println("Lowest  Value: " + low + " at Index:" + p2);
        
        
        
    }
}
    
    
        
   
    
