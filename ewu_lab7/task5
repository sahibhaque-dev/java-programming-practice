            obj1.Add();

            System.out.println("Enter two integers for subtraction:");
            Calculator obj2 = new Calculator(readInt(sc, "enter a : "), readInt(sc, "enter b : "));
            obj2.Subtract();

            System.out.println("Enter two integers for multiplication:");
            Calculator obj3 = new Calculator(readInt(sc, "enter a : "), readInt(sc, "enter b : "));
            obj3.multiply();

            System.out.println("Enter two integers for division:");
