//Write a program that prompts the user to enter the seconds, and display the hours, minutes and seconds for the input
//seconds. Here is a sample run:
package lab_1;
import java.util.Scanner;
public class task2 {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
            
        System.out.print("plz enter the total second:  ");
        int s = sc.nextInt();
        
        int hours = s / 3600;
        int minutes = (s % 3600) / 60;
        int seconds = s % 60;

        System.out.println("Hours: " + hours);
        System.out.println("Minutes: " + minutes);
        System.out.println("Seconds: " + seconds);

        
    }
    
}
