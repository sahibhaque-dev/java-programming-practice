//Write a program to compute the area of a circle and
//use the final keyword to specify the value of PI.
package lab_1;
import java.util.Scanner;
public class task1 {

    public static void main(String[] args) {
        final double pi = 3.1416;
        Scanner sc = new Scanner(System.in);
            
        System.out.print("plz enter the radius of the circle :  ");
        int r = sc.nextInt();
        
        double area=2*pi*r*r;
                System.out.println("this is the area of the circle  :  "+area+ "m");

        
    }
    
}
